# Copy to .env and adjust. Every variable is optional; the defaults shown are the
# values the code uses when the variable is unset. Never commit real secrets.

# Database used by the CLI, the API and `alembic upgrade head`.
WALLAPOP_TRACKER_DB_URL=sqlite:///data/wallapop_tracker.db

# Logging and metrics.
WALLAPOP_LOG_LEVEL=INFO
WALLAPOP_LOG_FORMAT=human
WALLAPOP_METRICS_ENABLED=true

# Optional LLM listing analysis. Disabled by default; never put real secrets here.
WALLAPOP_AI_ENABLED=false
WALLAPOP_AI_PROVIDER=openai-compatible
WALLAPOP_AI_BASE_URL=
WALLAPOP_AI_API_KEY=
WALLAPOP_AI_MODEL=
WALLAPOP_AI_TIMEOUT_SECONDS=30
WALLAPOP_AI_MAX_RETRIES=2

# Optional Telegram natural-language control; explicit commands always work.
WALLAPOP_TELEGRAM_NL_ENABLED=false

# Notification channels: all disabled by default. Enable a channel only when its
# destination below is configured.
WALLAPOP_NOTIFY_WEBHOOK_ENABLED=false
WALLAPOP_NOTIFY_DISCORD_ENABLED=false
WALLAPOP_NOTIFY_TELEGRAM_ENABLED=false

# Generic webhook destination and optional extra headers (JSON object of strings).
WALLAPOP_WEBHOOK_URL=
WALLAPOP_WEBHOOK_HEADERS={}

# Discord webhook destination.
WALLAPOP_DISCORD_WEBHOOK_URL=

# Telegram Bot API credentials. TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are still
# accepted as legacy aliases.
WALLAPOP_TELEGRAM_BOT_TOKEN=
WALLAPOP_TELEGRAM_CHAT_ID=
# Optional control bot process; ownership is persisted per Telegram chat_id.

# Delivery attempts before a notification is left failed.
WALLAPOP_NOTIFICATION_MAX_ATTEMPTS=3

# Optional worker lease settings used by the PostgreSQL worker implementation.
# WALLAPOP_WORKER_ID=replace-me
# WALLAPOP_JOB_LEASE_SECONDS=900
# WALLAPOP_NOTIFICATION_LEASE_SECONDS=300

# Optional, only for the opt-in live test and the manual E2E script.
# WALLAPOP_TEST_PROFILE_URL=https://es.wallapop.com/user/example
# WALLAPOP_E2E_PROFILE_URL_1=https://es.wallapop.com/user/example-1
# WALLAPOP_E2E_PROFILE_URL_2=https://es.wallapop.com/user/example-2
